#!/bin/sh
# =============================================================================
# fcc - compile C for the simulator
# =============================================================================
#
#   tools/fcc [gcc options] file.c ... -o prog
#
# Writes prog, an ELF executable, and prog.bin, the flat image that
# tools/fcc-run.mjs loads.  With -c, -S or -E it is just the compiler.
#
# The compiler is the one in build/gcc and the libgcc it built.  The program
# is linked with crt/crt0.s, the assembly libc in libc/, and ld/fructus-sim.ld.
#
# libc/ is written in the customasm dialect, which gas also reads but which has
# no .globl: every label at the start of a line that does not begin with `.'
# is exported, which is what customasm's flat namespace amounts to.
# =============================================================================
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
B=$root/build
X=$B/cross-bin
CC="$B/gcc/gcc/xgcc -B$B/gcc/gcc/ -B$X/ -isystem $root/crt/include"

out=a.out
prev=
for a in "$@"; do
    [ "$prev" = -o ] && out=$a
    case $a in -c|-S|-E) exec $CC "$@" ;; esac
    prev=$a
done

# crt0 and libc, rebuilt whenever a source is newer than the archive.
lib=$B/crt/libc.a
mkdir -p $B/crt
stale=
[ -f $lib ] || stale=1
for s in $root/crt/crt0.s $root/crt/*.c $root/crt/include/*.h $root/libc/*.s \
         $root/snippets/digits3.s $B/gcc/gcc/cc1; do
    [ $s -nt $lib ] && stale=1
done
if [ -n "$stale" ]; then
    rm -f $lib
    $X/fructus-elf-as -o $B/crt/crt0.o $root/crt/crt0.s
    # snippets/digits3.s comes along because printf's decimal conversion calls
    # it: three digits at a time, with no divide anywhere.
    for s in $root/libc/*.s $root/snippets/digits3.s; do
        n=$(basename $s .s)
        # A SECTION OF ITS OWN AS WELL AS A .globl, so that the --gc-sections
        # in the link below can drop a routine nobody calls.  These files hold
        # more than one: memcpy.s has memmove, memset.s has bzero, setjmp.s has
        # longjmp, and without this a program that calls either one carries
        # both.  Anything ahead of the first label stays in plain .text and is
        # kept by the relocation that reaches it.
        { printf '\t.text\n'
          sed 's/^\([A-Za-z_][A-Za-z0-9_]*\):/\t.section\t.text.\1,"ax"\n\t.globl\t\1\n\1:/' $s
        } > $B/crt/$n.s
        $X/fructus-elf-as -o $B/crt/$n.o $B/crt/$n.s
        $X/fructus-elf-ar rc $lib $B/crt/$n.o
    done
    # The C half of the library: the odds and ends in libc.c, and the heap.
    # Each is one object, but a section per function, and the link below
    # collects garbage, so a program still carries only what it calls.
    for c in libc malloc; do
        $CC -Os -ffunction-sections -c $root/crt/$c.c -o $B/crt/$c.o
        $X/fructus-elf-ar rc $lib $B/crt/$c.o
    done
    $X/fructus-elf-ranlib $lib
fi

# The image is RAM, code and data alike, so the one segment is RWX on purpose.
$CC -nostdlib -T $root/ld/fructus-sim.ld -Wl,--no-warn-rwx-segments,--gc-sections \
    $B/crt/crt0.o "$@" \
    -Wl,--start-group $lib -L$B/gcc/fructus-elf/libgcc -lgcc -Wl,--end-group
$X/fructus-elf-objcopy -O binary $out $out.bin
