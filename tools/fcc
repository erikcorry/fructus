#!/bin/sh
# =============================================================================
# fcc - compile C for the simulator
# =============================================================================
#
#   tools/fcc [gcc options] file.c ... -o prog
#
# Writes prog, an ELF executable, and prog.bin, the flat image that
# tools/fcc-run.mjs loads.  With -c, -S or -E it is just the compiler.
#
# `just install-gcc' links this file into $HOME/fructus-tools/bin as
# fructus-elf-gcc and fructus-elf-g++, so the installed compiler IS this one:
# the build tree's gcc, crt/include, libc and the simulator's link.  Through
# the link $0 is the link, so the repository is found from what it points at.
#
# The compiler is the one in build/gcc and the libgcc it built.  The program
# is linked with crt/crt0.s, the assembly libc in libc/, and ld/fructus-sim.ld.
#
# libc/ is written in the customasm dialect, which gas also reads but which has
# no .globl: every label at the start of a line that does not begin with `.'
# is exported, which is what customasm's flat namespace amounts to.
# =============================================================================
set -e
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
B=$root/build
X=$B/cross-bin
# C OR C++, DECIDED BY THE SOURCE NAMES.  A C++ source switches the driver, the
# include paths and the runtime library together, because on this target none
# of the three is found by default.
#
# THE TWO -I FLAGS ARE BOTH REQUIRED.  GCC was configured to look for its C++
# headers under $HOME/fructus-tools, which build-gcc.sh never installs to, so
# xg++ finds NOTHING on its own - `xg++ -E -v' reports only gcc/include and
# gcc/include-fixed.  The first path is the library's headers; the second holds
# bits/c++config.h, which is generated per target, and <type_traits> does not
# compile without it.
#
# THE EMBEDDED SUBSET, as on an ESP32: no exceptions, no RTTI, no thread-safe
# statics.
#
# operator new AND delete ARE OURS, in crt/new.cc, and that is not a taste.
# libsupc++ defines them, but it was built WITH exceptions, so its operator new
# throws std::bad_alloc when malloc fails - and the archive member defining it
# reaches __cxa_throw and then _Unwind_RaiseException, which this target has
# not got.  Defining them ourselves means that member is never extracted.
# crt/new.cc explains why neither -fno-exceptions nor --gc-sections can help.
#
# AND STATIC CONSTRUCTORS ARE NOT RUN.  crt0.s calls main directly and neither
# linker script collects .init_array, so a global object with a constructor
# comes up zero-filled from .bss.  It fails silently; see tools/build-gcc.sh.
# Called as g++ it is always C++, as g++ is: a link of objects alone has no
# source name to go by, and would otherwise leave out libsupc++.
cxx=
case $(basename "$0") in *g++) cxx=1 ;; esac
for a in "$@"; do case $a in *.cc|*.cpp|*.cxx|*.C|*.c++) cxx=1 ;; esac; done

L3=$B/gcc/fructus-elf/libstdc++-v3
CXXF="-I$L3/include -I$L3/include/fructus-elf \
      -fno-exceptions -fno-rtti -fno-threadsafe-statics"

# THE LIBRARY IS ALWAYS BUILT BY THE SAME TWO COMPILERS, whatever the program
# is.  $CC follows the caller's sources, but crt/libc.c and crt/malloc.c are C,
# crt/new.cc is C++, and all three go into ONE archive that both kinds of
# program link against.  Choosing their compiler by what the caller happened to
# hand us would make the archive's contents depend on which program was built
# first - and the staleness check below compares only source timestamps, so it
# would never notice.  That is the same shape as every other staleness trap
# here: a check that compares the wrong thing.
CCC="$B/gcc/gcc/xgcc -B$B/gcc/gcc/ -B$X/ -isystem $root/crt/include"
CXXC="$B/gcc/gcc/xg++ -B$B/gcc/gcc/ -B$X/ -isystem $root/crt/include $CXXF"

CXXLIB=
if [ -n "$cxx" ]; then
    CC="$CXXC"
    CXXLIB="-L$L3/libsupc++/.libs -lsupc++"
else
    CC="$CCC"
fi

out=a.out
prev=
for a in "$@"; do
    [ "$prev" = -o ] && out=$a
    case $a in -c|-S|-E) exec $CC "$@" ;; esac
    prev=$a
done

# crt0 and libc, rebuilt whenever a source is newer than the archive.
lib=$B/crt/libc.a
mkdir -p $B/crt
stale=
[ -f $lib ] || stale=1
for s in $root/crt/crt0.s $root/crt/*.c $root/crt/*.cc $root/crt/include/*.h \
         $root/libc/*.s $root/snippets/digits3.s $B/gcc/gcc/cc1 \
         $B/gcc/gcc/cc1plus; do
    [ $s -nt $lib ] && stale=1
done
if [ -n "$stale" ]; then
    rm -f $lib
    $X/fructus-elf-as -o $B/crt/crt0.o $root/crt/crt0.s
    # snippets/digits3.s comes along because printf's decimal conversion calls
    # it: three digits at a time, with no divide anywhere.
    for s in $root/libc/*.s $root/snippets/digits3.s; do
        n=$(basename $s .s)
        # A SECTION OF ITS OWN AS WELL AS A .globl, so that the --gc-sections
        # in the link below can drop a routine nobody calls.  These files hold
        # more than one: memcpy.s has memmove, memset.s has bzero, setjmp.s has
        # longjmp, and without this a program that calls either one carries
        # both.  Anything ahead of the first label stays in plain .text and is
        # kept by the relocation that reaches it.
        { printf '\t.text\n'
          sed 's/^\([A-Za-z_][A-Za-z0-9_]*\):/\t.section\t.text.\1,"ax"\n\t.globl\t\1\n\1:/' $s
        } > $B/crt/$n.s
        $X/fructus-elf-as -o $B/crt/$n.o $B/crt/$n.s
        $X/fructus-elf-ar rc $lib $B/crt/$n.o
    done
    # The C half of the library: the odds and ends in libc.c, and the heap.
    # Each is one object, but a section per function, and the link below
    # collects garbage, so a program still carries only what it calls.
    #
    # -Wall -Werror IS HERE AND NOT ON $CC, and the difference matters.  This
    # loop compiles OUR code, where a warning is a defect and should stop the
    # build.  $CC also compiles whatever a caller hands it, and that includes
    # every file in gcc.c-torture/execute - thousands of deliberately odd C
    # programs whose warnings are not ours to fix.  Worse, tools/torture.mjs
    # classifies outcomes by matching `error:' in the output, so promoting
    # warnings to errors there would file working programs as compile
    # failures.
    for c in libc malloc; do
        $CCC -Os -Wall -Werror -ffunction-sections -c $root/crt/$c.c -o $B/crt/$c.o
        $X/fructus-elf-ar rc $lib $B/crt/$c.o
    done
    # THE C++ RUNTIME SUPPORT, ALWAYS BUILT AND ALWAYS ARCHIVED.  A C program
    # pays nothing for it: a member is extracted from an archive only to
    # resolve an UNDEFINED symbol, and a C program has no operator new to
    # resolve.  Building it unconditionally is what keeps the archive the same
    # whichever language the caller brought.
    $CXXC -Os -Wall -Werror -ffunction-sections -c $root/crt/new.cc -o $B/crt/new.o
    $X/fructus-elf-ar rc $lib $B/crt/new.o
    $X/fructus-elf-ranlib $lib
fi

# The image is RAM, code and data alike, so the one segment is RWX on purpose.
$CC -nostdlib -T $root/ld/fructus-sim.ld -Wl,--no-warn-rwx-segments,--gc-sections \
    $B/crt/crt0.o "$@" \
    -Wl,--start-group $lib $CXXLIB -L$B/gcc/fructus-elf/libgcc -lgcc -Wl,--end-group
$X/fructus-elf-objcopy -O binary $out $out.bin
