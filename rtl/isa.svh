// =============================================================================
// isa.svh - the facts about the instruction set that rtl/ writes by hand
// =============================================================================
//
// GENERATED by tools/gen-isa.js from isa/fructus.toml.  Do not edit.
//
// brk is opcode 0x00, and sp and lr are r6 and r7: rtl/cpu.sv relies on
// both, and tools/gen-isa.js checks them.
// =============================================================================

`ifndef FRUCTUS_ISA_SVH
`define FRUCTUS_ISA_SVH

// [cpu.vectors] brk: where brk and the interrupt line go.
`define FRUCTUS_VECTOR_BRK 16'hfff8

// [cpu.vectors] io_guard: where a load or store that touches a guard goes.
`define FRUCTUS_VECTOR_IO_GUARD 16'hffcc

// [cpu.vectors] divide_by_zero: where a recip whose ra has bit 15 clear goes.
`define FRUCTUS_VECTOR_DIVIDE_BY_ZERO 16'hffc8

// [cpu.io]: the page, whose first and last 16 bytes are its guards.
`define FRUCTUS_IO_PAGE 8'h04

// [cpu.io]: the shadows' words in the I/O page, which loads and stores reach.
`define FRUCTUS_IO_SHADOW_SP  16'h0410
`define FRUCTUS_IO_SHADOW_LR  16'h0412
`define FRUCTUS_IO_SHADOW_ISP 16'h0414

// [cpu.io]: the cycle counter, two read-only words, low first.
`define FRUCTUS_IO_CYCLES 16'h0424

// [cpu.io]: the UART's words - tools/fpga-system.sv's, with FRUCTUS_UART.
`define FRUCTUS_IO_CONSOLE      16'h0420
`define FRUCTUS_IO_UART_STATUS  16'h0422
`define FRUCTUS_IO_UART_DIVISOR 16'h0428

// [cpu.io]: the USB port's - tools/fpga-system.sv's, with FRUCTUS_USB.
`define FRUCTUS_IO_USB_DATA    16'h0430
`define FRUCTUS_IO_USB_STATUS  16'h0432
`define FRUCTUS_IO_USB_CTRL    16'h0434

// The registers the exception routines and the block moves name.
`define FRUCTUS_REG_SP 3'd6
`define FRUCTUS_REG_LR 3'd7
`define FRUCTUS_REG_SPLR 2'd3   // sp and lr but for bit 0, which is 1 for lr

// The fast unary operations, by sel - the right-hand operand's bits 2:1, which
// for a unary instruction is the imm3 value its encoding names.
`define FRUCTUS_UNARY_FAST(sel, bitrev, sxt8) (sel[1] ? sxt8 : bitrev)

// The slow pair, clz and popcount: popcount when this is 1.
`define FRUCTUS_UNARY_POP(sel) (sel[1])

`endif
